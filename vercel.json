{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/jenn/art",
      "destination": "/index.html"
    },
    {
      "source": "/jenn/art/",
      "destination": "/index.html"
    },
    {
      "source": "/ashley/what-if",
      "destination": "/index.html"
    },
    {
      "source": "/ashley/what-if/",
      "destination": "/index.html"
    },
    {
      "source": "/penny/after-hours",
      "destination": "/index.html"
    },
    {
      "source": "/penny/after-hours/",
      "destination": "/index.html"
    },
    {
      "source": "/bunker",
      "destination": "/index.html"
    },
    {
      "source": "/grimoire",
      "destination": "/grimoire/index.html"
    },
    {
      "source": "/grimoire/",
      "destination": "/grimoire/index.html"
    },
    {
      "source": "/dice",
      "destination": "/dice/index.html"
    },
    {
      "source": "/dice/",
      "destination": "/dice/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ashley/what-if",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/ashley/what-if/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/penny/after-hours",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/penny/after-hours/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    }
  ]
}
